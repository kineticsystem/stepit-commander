# The upstream workspace of industrial_ci, see .github/workflows/industrial_ci.yml.
# BehaviorTree.ROS2 is a git submodule, which industrial_ci does not check out:
# it imports it from here instead, at the commit the submodule records. Update
# both together.
repositories:
  BehaviorTree.ROS2:
    type: git
    url: https://github.com/kineticsystem/BehaviorTree.ROS2.git
    version: 23dba60f272969934acfd3618b676560338d3ac7
