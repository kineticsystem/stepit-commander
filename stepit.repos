# BehaviorTree.ROS2, which is not released as a Debian package: our fork, at the
# commit the server is built and tested with. bin/update.sh imports it into
# modules/, and industrial_ci into its upstream workspace. A rig that builds the
# commander with other modules lists it once, in its own .repos file, at the
# same commit.
repositories:
  BehaviorTree.ROS2:
    type: git
    url: https://github.com/kineticsystem/BehaviorTree.ROS2.git
    version: b0ae01d1eb05e8ed33237fc8ebb3d2b8f0b820dc
