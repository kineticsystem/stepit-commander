<?xml version="1.0" encoding="UTF-8"?>
<!--
  Subtree: EnsureControllers

  Makes sure that exactly the given controllers are driving the robot: whatever
  else is running is stopped, and the requested ones are activated.

  It takes its controllers from a port, so an objective can call it with a fixed
  controller it needs:

    <SubTree ID="EnsureControllers" controllers="joint_trajectory_controller"/>

  or forward what the command asked for:

    <SubTree ID="EnsureControllers" controllers="{@controllers}"/>

  Doing nothing is a valid outcome: the switch is asked for with the
  'best_effort' strictness, so a controller that is already running is left
  alone instead of being restarted.

  Broadcasters, such as the joint_state_broadcaster, own no command interface
  and are therefore never stopped.
-->
<root BTCPP_format="4">

  <BehaviorTree ID="EnsureControllers" _description="Makes sure that exactly the given controllers are driving the robot, leaving broadcasters running.">
    <Sequence>

      <!-- Which controllers are driving the robot right now? The ones we are
           about to activate are left out: they must not be stopped. -->
      <GetActiveControllers _description="Lists the controllers driving the robot, except the ones about to be activated: these are the ones to stop."
                            service_name="/controller_manager/list_controllers"
                            exclude="{controllers}"
                            active_controllers="{active_controllers}"/>

      <!-- Stop them and start the requested ones, in one control cycle. -->
      <SwitchController _description="Stops the other controllers and starts the requested ones in one control cycle; one already running is left alone."
                        service_name="/controller_manager/switch_controller"
                        activate="{controllers}"
                        deactivate="{active_controllers}"
                        strictness="best_effort"/>

    </Sequence>
  </BehaviorTree>

</root>
