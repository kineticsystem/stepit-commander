<?xml version="1.0" encoding="UTF-8"?>
<!--
  Objective: MoveJointsDirectlyTo

  Moves one or more joints to absolute positions through the position
  controller: the microcontroller plans each move itself, on its own trapezoid,
  as fast as the motors allow.

    ros2 action send_goal /commander/execute_objective \
      btcpp_ros2_interfaces/action/ExecuteTree \
      "{target_tree: MoveJointsDirectlyTo,
        payload: '{joints: [joint1, joint2], positions: [0.0, 1.57]}'}"

  It is the direct counterpart of MoveJointsTo, which plans a trajectory and
  sends it to the trajectory controller. Here nothing is planned: there is a
  single planner, the microcontroller's, so the motors do not trail a plan and
  settle at its end. The price is that the joints are not synchronised, each
  one runs its own profile, and that the limits are those of the motors.

  The objective succeeds once every joint is within 0.01 rad of its target and
  has stopped. Cancelling it deactivates the position controller, and the
  hardware brakes every joint to rest on its own profile.
-->
<root BTCPP_format="4" main_tree_to_execute="MoveJointsDirectlyTo">

  <BehaviorTree ID="MoveJointsDirectlyTo" _description="Moves one or more joints to absolute positions, each on the microcontroller's own profile, with the position controller.">
    <Sequence>

      <!-- The targets are sent to the position controller, so make sure that
           this is the controller driving the robot, and no other. -->
      <SubTree ID="EnsureControllers" controllers="position_controller"/>

      <!-- The position controller takes every one of its joints, in the order
           of robot_description/config/controllers.yaml. -->
      <CommandJointPositions _description="Sends the joints to their targets through the position controller, and waits until they are there."
                             topic_name="/position_controller/commands"
                             controller_joints="joint1;joint2;joint3;joint4;joint5"
                             joint_names="{@joints}"
                             positions="{@positions}"/>

    </Sequence>
  </BehaviorTree>

  <!-- The payload of the objective, for editors: what each entry is, with an example. -->
  <TreeNodesModel>
    <SubTree ID="MoveJointsDirectlyTo">
      <input_port name="joints">the joints to move, e.g. joint1 or [joint1, joint2]</input_port>
      <input_port name="positions">where to move them, in radians: one for every joint, or one per joint, e.g. 1.57 or [0.0, 1.57]</input_port>
    </SubTree>
  </TreeNodesModel>

</root>
