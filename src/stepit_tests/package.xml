<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stepit_tests</name>
  <version>0.1.0</version>
  <description>
    Tests of the commander: the logic of the behaviors, the payload of a command
    and the objectives themselves, run against a fake robot.
  </description>
  <maintainer email="lentigrams@gmail.com">developer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_index_cpp</test_depend>
  <test_depend>behaviortree_cpp</test_depend>
  <test_depend>behaviortree_ros2</test_depend>
  <test_depend>stepit_behaviors</test_depend>
  <test_depend>stepit_objectives</test_depend>
  <test_depend>stepit_server</test_depend>
  <test_depend>control_msgs</test_depend>
  <test_depend>controller_manager_msgs</test_depend>
  <test_depend>rclcpp</test_depend>
  <test_depend>rclcpp_action</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>trajectory_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
