<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stepit_server</name>
  <version>0.1.0</version>
  <description>
    The single action server that executes the objectives of the robot. It knows
    nothing about the robot itself: it only loads behaviors and objectives, and
    hands the parameters of a command over to the behavior tree.
  </description>
  <maintainer email="lentigrams@gmail.com">developer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>behaviortree_cpp</depend>
  <depend>behaviortree_ros2</depend>
  <depend>btcpp_ros2_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>yaml-cpp</depend>

  <exec_depend>stepit_behaviors</exec_depend>
  <exec_depend>stepit_objectives</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
