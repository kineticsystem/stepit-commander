<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stepit_server_tests</name>
  <version>0.1.0</version>
  <description>
    Tests of the commander server: the payload of a command, the status it
    reports while a tree runs, and reading the objectives again when they change.
  </description>
  <maintainer email="lentigrams@gmail.com">developer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>behaviortree_cpp</test_depend>
  <test_depend>btcpp_ros2_interfaces</test_depend>
  <test_depend>rclcpp</test_depend>
  <test_depend>rclcpp_action</test_depend>
  <test_depend>stepit_server</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
