<?xml version="1.0" encoding="UTF-8"?>
<!--
  Objective: ActivateController

  Stops whichever controller is currently driving the robot and activates the
  requested one instead.

    ros2 action send_goal /commander/execute_objective \
      btcpp_ros2_interfaces/action/ExecuteTree \
      "{target_tree: ActivateController, payload: '{controllers: velocity_controller}'}"

  A single name may be given as a scalar, e.g. {controllers: velocity_controller},
  or as a list, e.g. {controllers: [velocity_controller]}.

  The objective is only the adapter between the payload of the command and the
  EnsureControllers subtree, which holds the actual work and is reused by the
  objectives that need a specific controller to be running.
-->
<root BTCPP_format="4" main_tree_to_execute="ActivateController">

  <BehaviorTree ID="ActivateController" _description="Stops whichever controllers are driving the robot and activates the requested ones instead.">
    <SubTree ID="EnsureControllers" controllers="{@controllers}"/>
  </BehaviorTree>

</root>
